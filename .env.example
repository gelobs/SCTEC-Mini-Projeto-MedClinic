# Porta em que a API vai escutar
PORT=3000

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medclinic

# JWT
JWT_SECRET=troque-por-uma-chave-secreta-forte
JWT_EXPIRES_IN=1h

# Credenciais do usuário Administrador criado pelo script de seed (npm run seed)
ADMIN_SEED_EMAIL=admin@medclinic.com
ADMIN_SEED_PASSWORD=Admin@123
